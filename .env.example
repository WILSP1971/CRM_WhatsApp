# ============================================================================
# .env.example — Variables de entorno para OmniCore AI (Entregable #2)
# ============================================================================
# Copiar a .env y reemplazar valores. NUNCA commitear .env (ver .gitignore).
# SENSIBLE: datos personales, secretos y configuración de IA local sin egress.
# ============================================================================

# --- PostgreSQL 16 + pgvector ---
# DB_PASSWORD: OBLIGATORIO (sin default). Fuera de ENVIRONMENT=development el
# backend ABORTA el arranque si falta o es débil (<32 caracteres o genérico
# tipo "changeme"/"postgres") — CHECKPOINT C3, fail-fast (SPEC-013).
DB_NAME=omnicore_ai
DB_PORT=5432

# --- Roles de base de datos (ADR-008: RLS efectiva) ---
# PostgreSQL NUNCA aplica Row Level Security a superusuarios ni a roles con
# BYPASSRLS (ni con FORCE ROW LEVEL SECURITY). Por eso el runtime de la app
# (api/workers) y las migraciones (Alembic/DDL) usan roles SEPARADOS:
#
# DB_MIGRATION_USER / DB_PASSWORD: rol PRIVILEGIADO/owner del esquema
# (superusuario de bootstrap de la imagen de Postgres, `POSTGRES_USER`).
# SOLO lo usa Alembic (`make migrate`) para DDL (CREATE/ALTER/DROP). NUNCA
# se usa para servir peticiones HTTP.
DB_MIGRATION_USER=postgres
DB_PASSWORD=changeme-solo-para-desarrollo-local

# DB_APP_ROLE / DB_APP_PASSWORD: rol de APLICACIÓN, NO-superusuario
# (NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE), creado por
# `init-sql/01-roles-app.sh` en la primera inicialización del volumen de
# `db`. Es el rol de RUNTIME de `api`/`rag_worker`/`sentiment_worker`: con
# este rol, RLS (ENABLE+FORCE, ADR-004) SÍ se aplica en cada consulta.
# GRANTs mínimos: USAGE de schema + SELECT/INSERT/UPDATE de tablas de datos.
# CERO privilegios de DDL. Generar una contraseña fuerte y DISTINTA de
# DB_PASSWORD, p.ej.: openssl rand -hex 32
DB_APP_ROLE=omnicore_app
DB_APP_PASSWORD=changeme-solo-para-desarrollo-local-app

# DATABASE_URL: cadena de conexión de RUNTIME (rol omnicore_app) que usan
# api/workers. DATABASE_URL_MIGRATIONS: cadena de conexión SOLO para Alembic
# (rol privilegiado DB_MIGRATION_USER). Si se dejan explícitas aquí, tienen
# prioridad sobre las variables DB_*/DB_APP_* individuales.
DATABASE_URL=postgresql://omnicore_app:changeme-solo-para-desarrollo-local-app@db:5432/omnicore_ai
DATABASE_URL_MIGRATIONS=postgresql://postgres:changeme-solo-para-desarrollo-local@db:5432/omnicore_ai

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# --- Ollama (IA local, red interna sin egress) — SPEC-016 ---
# OLLAMA_BASE_URL: SOLO puede apuntar al servicio interno `ia` (red Docker
# `ia_internal`, internal: true) o a loopback (desarrollo local sin Docker).
# CHECKPOINT SENSIBLE (.no-externo, RNF-01/CE-21): `Settings` (config.py)
# ABORTA el arranque si esta URL no resuelve a un host interno permitido;
# `check-externos-backend.sh` también audita este valor. NUNCA un dominio
# de internet ni una API de terceros (prohibido).
OLLAMA_BASE_URL=http://ia:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_THREAD=4
# Timeouts del cliente de IA local (segundos). AI_CONNECT_TIMEOUT_SECONDS
# corto porque el servicio es local (misma red Docker); AI_REQUEST_TIMEOUT_SECONDS
# más generoso para generación de texto en CPU (fallback Q4, R-21).
AI_CONNECT_TIMEOUT_SECONDS=5
AI_REQUEST_TIMEOUT_SECONDS=30

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# --- Seguridad (C3: secretos SOLO en env) ---
# JWT_SECRET_KEY: OBLIGATORIO (sin default). Fuera de ENVIRONMENT=development
# el backend ABORTA el arranque si falta, es genérico ("changeme","secret",
# etc.) o mide menos de 32 caracteres — un secreto conocido permitiría
# forjar tokens y hacer bypass de RLS (CHECKPOINT C3, fail-fast, SPEC-013).
# Generar uno fuerte, p.ej.: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Rate-limit de login (SPEC-013: bloqueo por intentos fallidos) ---
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Si Redis no está accesible: en development degrada a memoria de proceso
# (con warning); fuera de development, por defecto (true) se RECHAZA el
# intento (503) en vez de degradar de forma insegura/no confiable
# multi-worker. Poner "false" solo si se acepta ese riesgo explícitamente.
LOGIN_RATE_LIMIT_STRICT_REDIS=true

# --- Configuración de aplicación ---
LOG_LEVEL=INFO
# CORS_ORIGINS: allowlist explícita de orígenes permitidos (coma-separados).
# NUNCA se usa "*" cuando hay credenciales habilitadas (cookies/Authorization).
# Si se deja vacío fuera de development, el backend deshabilita CORS
# (sin comodín ni credenciales) en vez de abrir el acceso — CHECKPOINT C3.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- RAG (parámetros de recuperación) ---
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.7

# --- Datos personales (HABEAS DATA/GDPR) — SPEC-021 ---
# DATA_RETENTION_DAYS: antigüedad (días) de `updated_at` para que un contacto
# YA INACTIVO (borrado lógico, C2) sea candidato a anonimización por el job
# de retención (`app.services.retention_service`, invocable con
# `python -m app.workers.retention_job`). Nunca actúa sobre contactos activos.
DATA_RETENTION_DAYS=90
# ENABLE_DATA_ANONYMIZATION: por defecto "false" -> el job corre en modo
# dry-run (solo reporta candidatos, no escribe nada). Poner "true" para que
# el job anonimice de verdad (borrado lógico + campos identificantes
# sobrescritos, nunca DELETE físico).
ENABLE_DATA_ANONYMIZATION=false

# ============================================================================
# Reverse proxy TLS (Entregable #4, SPEC-035, ADR-010)
# ============================================================================
# Caddy reverse proxy: expone SOLO el path del webhook de grabaciones.
# En desarrollo: auto-genera TLS autofirmado para localhost.
# En producción: usar certificado válido (Let's Encrypt, etc).
#
# CADDY_DOMAIN: dominio de listening (desarrollo: localhost, producción: reemplazar)
CADDY_DOMAIN=localhost
#
# CADDY_HTTP_PORT / CADDY_HTTPS_PORT: puertos de listening (por defecto: 80, 443).
# En desarrollo sin privilegios de root: reemplazar por 8080, 8443.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ============================================================================
# STT local + almacén de audio cifrado (Entregable #4, SPEC-035/SPEC-038, ADR-009)
# ============================================================================
# Transcripción de audio 100% local con faster-whisper (large-v3 es-CO, fallback medium).
# SENSIBLE: audio como dato personal/PHI — jamás a terceros, cifrado en reposo,
# retención política HABEAS DATA/GDPR, acceso auditado.
#
# STT_MODEL: nombre del modelo faster-whisper a usar. Por defecto large-v3 para
# máxima precisión con GPU ≥16GB (SUP-44); fallback medium para CPU o GPU <16GB.
# NUNCA descargar de Hugging Face en runtime (pesos por volumen, ADR-009).
STT_MODEL=large-v3
#
# STT_MODEL_DIR: ruta del volumen en el contenedor donde se montan los pesos
# de whisper/faster-whisper (sin descarga en runtime, ADR-009). Descarga manual
# pre-deployment: `faster-whisper-cli download large-v3` o equivalente.
STT_MODEL_DIR=/root/.cache/huggingface/models
#
# STT_LANGUAGE: código de idioma para el modelo. Por defecto: es (español).
# El modelo large-v3 está preentrenado en ~99 idiomas; se specifica aquí solo
# para acelerar las búsquedas internas del modelo.
STT_LANGUAGE=es
#
# STT_DEVICE: dispositivo de inferencia (cuda|cpu|mps). Por defecto: cuda.
# En CPU, degradar fallback a medium o whisper.cpp; documentado en
# SPEC-042 (performance). El worker valida disponibilidad en startup (health).
STT_DEVICE=cuda
#
# STT_FALLBACK_MODEL / STT_FALLBACK_DEVICE: modelo/dispositivo de repliegue
# (SPEC-038, RNF-42/R-42) si la carga en STT_MODEL/STT_DEVICE falla (driver/
# CUDA ausente, OOM, pesos no montados) — RTF degradado pero DOCUMENTADO,
# nunca un job STT perdido silenciosamente.
STT_FALLBACK_MODEL=medium
STT_FALLBACK_DEVICE=cpu
#
# STT_COMPUTE_TYPE / STT_FALLBACK_COMPUTE_TYPE: cuantización de CTranslate2
# (float16 recomendado en GPU, int8 recomendado en CPU por rendimiento).
STT_COMPUTE_TYPE=float16
STT_FALLBACK_COMPUTE_TYPE=int8
#
# STT_VAD_FILTER_ENABLED: activa el VAD integrado de faster-whisper para
# saltar silencios antes de transcribir (SPEC-038).
STT_VAD_FILTER_ENABLED=true
#
# STT_DIARIZATION_ENABLED / STT_DIARIZATION_SILENCE_GAP_SECONDS: diarización
# BÁSICA opcional (SPEC-038, RF-02) que etiqueta turnos agente/cliente por
# heurística de silencio prolongado entre segmentos VAD (no es un modelo de
# diarización dedicado); activable/desactivable sin tocar código.
STT_DIARIZATION_ENABLED=true
STT_DIARIZATION_SILENCE_GAP_SECONDS=1.5
#
# AUDIO_STORAGE_PATH: ruta del volumen cifrado on-prem donde se guarda el audio
# en reposo (C3, ADR-009). En desarrollo: /audio_store (volumen local); en
# producción: punto de montaje de LUKS/dm-crypt/ZFS/storage-backend nativo
# (verificado en init: debe estar cifrado, no en claro).
AUDIO_STORAGE_PATH=/audio_store
#
# AUDIO_ENCRYPTION_KEY: clave de cifrado del almacén de audio (C3, OBLIGATORIO).
# NUNCA un default débil; en ENVIRONMENT != development, falla el arranque si
# falta o mide <32 caracteres. En producción, usar secret manager (HashiCorp Vault).
# Generar: openssl rand -base64 32
AUDIO_ENCRYPTION_KEY=changeme-solo-para-desarrollo-local-audio-key
#
# AUDIO_RETENTION_DAYS: política de retención del audio (días). Por defecto: 30
# (SUP-49, HABEAS DATA/GDPR). Transcurridos, el job de retención (SPEC-041)
# purga/anonimiza el audio (borrado lógico); acceso auditado (registro creado_por/fecha).
AUDIO_RETENTION_DAYS=30
#
# CALL_TRANSCRIPT_RETENTION_DAYS: política de retención de la TRANSCRIPCIÓN
# de la llamada (días), independiente del audio. Por defecto: 90 (alineado
# con DATA_RETENTION_DAYS de SPEC-021; SPEC-041 no fija un valor distinto).
CALL_TRANSCRIPT_RETENTION_DAYS=90
#
# AUDIO_RETENTION_ACTION: acción al vencer la retención del AUDIO. Valores:
# "purge" (default, borra físicamente el blob cifrado) | "anonymize" (alias
# documentado; hoy con el mismo efecto que "purge" para un blob binario).
AUDIO_RETENTION_ACTION=purge
#
# CALL_TRANSCRIPT_RETENTION_ACTION: acción al vencer la retención de la
# TRANSCRIPCIÓN. Valores: "anonymize" (default, sobrescribe el texto con un
# marcador no identificante, conserva la fila) | "purge" (además aplica
# borrado lógico explícito de la transcripción).
CALL_TRANSCRIPT_RETENTION_ACTION=anonymize
#
# ENABLE_CALL_RETENTION_PURGE: por defecto "false" -> el job de retención de
# audio/transcripción (app.workers.call_retention_job, SPEC-041) corre en
# modo dry-run (solo reporta candidatos, no purga/anonimiza nada) hasta que
# se habilite explícitamente. Cambiar a "true" es un CAMBIO SENSIBLE (C6):
# requiere aprobación del Lead + notificación.
ENABLE_CALL_RETENTION_PURGE=false
#
# PHI_MODE_ENABLED: interruptor maestro del endurecimiento PHI (ADR-009
# endurecido). Por defecto "false" (dominio HABEAS DATA/comercial, SUP-45).
# Activar SOLO si el Lead confirma dominio de salud/PHI — es un CAMBIO
# SENSIBLE (C6).
PHI_MODE_ENABLED=false
#
# TRANSCRIPT_FIELD_ENCRYPTION_ENABLED: TODO (SPEC-041, si PHI) — punto de
# extensión preparado pero SIN lógica de cifrado de campo implementada
# todavía (ver docstring de app/core/config.py). Sin efecto mientras
# PHI_MODE_ENABLED=false.
TRANSCRIPT_FIELD_ENCRYPTION_ENABLED=false

# ============================================================================
# WhatsApp Business Cloud API (Entregable #3, SPEC-024/SPEC-026/SPEC-029)
# ============================================================================
# Variables para el canal de WhatsApp. CRÍTICO (SENSIBLE, C3): estos 4 tokens
# NUNCA deben hardcodearse en el código, aparecer en logs, o commiterse en repo.
# Usar un secret manager en producción (p.ej. HashiCorp Vault, AWS Secrets Manager).
# OBLIGATORIO en ENVIRONMENT != development: Si faltan, el backend FALLA en arranque
# (fail-fast, SPEC-024 adición futura a la validación en config.py).
#
# WHATSAPP_TOKEN: Token de acceso permanente (long-lived) de Meta.
# Revocar y rotar regularmente (SPEC-034, runbook).
WHATSAPP_TOKEN=your-whatsapp-business-token-placeholder
#
# WHATSAPP_PHONE_NUMBER_ID: ID de número de teléfono de WhatsApp del cliente.
# Obtenido al dar de alta el número en WhatsApp Business Platform.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-placeholder
#
# WHATSAPP_VERIFY_TOKEN: Token para validar la solicitud GET de Meta (challenge).
# Debe coincidir con el que se configuró en el webhook de Meta.
# Generar uno fuerte: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=your-verify-token-placeholder
#
# WHATSAPP_APP_SECRET: Secreto de aplicación para validar la firma HMAC-SHA256
# de los webhooks POST (X-Hub-Signature-256). Obtenido de Meta (App Settings).
# CRÍTICO: si es incorrecto, todos los webhooks fallarán (401 Unauthorized).
WHATSAPP_APP_SECRET=your-app-secret-placeholder
#
# --- Envío saliente (SPEC-029, worker `wa_send_worker`, ADR-006) ---
# WHATSAPP_API_VERSION: versión de la Graph API. El HOST queda FIJO a
# graph.facebook.com en app/integrations/whatsapp/graph_client.py (RNF-01):
# esta variable NUNCA puede reapuntar a otro dominio.
WHATSAPP_API_VERSION=v21.0
#
# WHATSAPP_SESSION_WINDOW_HOURS: ventana de servicio (RF-03) desde el último
# mensaje del CONTACTO; dentro de ventana -> texto libre, fuera -> plantilla.
WHATSAPP_SESSION_WINDOW_HOURS=24
#
# WHATSAPP_TEMPLATE_NAME / WHATSAPP_TEMPLATE_LANGUAGE: plantilla HSM
# utilitaria mínima (≥1, RF-03) ya aprobada por Meta, usada fuera de la
# ventana de 24h. Sin plantilla configurada, el envío fuera de ventana se
# bloquea con motivo (no se intenta la Graph API).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
#
# WHATSAPP_SEND_TIMEOUT_SECONDS / WHATSAPP_SEND_MAX_RETRIES /
# WHATSAPP_SEND_BACKOFF_BASE_SECONDS: timeouts y reintentos idempotentes
# (RNF-05) ante 429/5xx de Meta.
WHATSAPP_SEND_TIMEOUT_SECONDS=10
WHATSAPP_SEND_MAX_RETRIES=3
WHATSAPP_SEND_BACKOFF_BASE_SECONDS=1
#
# VOICE_NOTE_MAX_DURATION_SECONDS: límite de duración (segundos) de una nota
# de voz de WhatsApp aceptada para transcripción (SPEC-055, F2, R-66). Por
# defecto 600 (10 min, P1). Una nota que lo excede se descarta amablemente
# (auto-respuesta al contacto + transcripcion_estado="descartada_por_duracion"),
# NUNCA se encola en stt:jobs. Configurable por env sin cambio de código.
VOICE_NOTE_MAX_DURATION_SECONDS=600

# ============================================================================
# Dashboard de métricas de negocio — Entregable #5.5 (PLAN-007, SPEC-062/063)
# ============================================================================
#
# ANALYTICS_MAX_RANGE_DAYS: máximo de días (inclusive) permitido en el rango
# [desde, hasta] de GET /api/v1/analytics/business (RNF-73, protección contra
# queries runaway). Un rango mayor devuelve 422, nunca 500 ni un cálculo
# truncado en silencio. Por defecto 366 (cubre un año calendario, incluido
# bisiesto). Configurable por env sin cambio de código.
ANALYTICS_MAX_RANGE_DAYS=366

# ============================================================================
# VoiceBot en vivo — Entregable #5, F0 (SPEC-044, ADR-011/ADR-012, SPEC-046/047/048)
# ============================================================================
# Configuración de voz en vivo: STT ligero + TTS local + NLU de intent contra
# catálogo cerrado. GPU compartida entre voz en vivo (prioritaria) y batch
# (despriorizanda, ADR-011). Por defecto: placeholders y sensibles para F0.
#
# STT en vivo (SPEC-047): modelo ligero para clasificar intent (no transcripción
# legal, esa es batch con large-v3 de #4). Modelos: distil-whisper, faster-whisper
# small/medium cuantizado int8 (recomendado para GPU compartida bajo presupuesto
# de latencia ≤700ms p95, ADR-011 §3).
STT_LIVE_MODEL=distil-whisper
#
# STT_LIVE_LANGUAGE / STT_LIVE_DEVICE / STT_LIVE_COMPUTE_TYPE: parámetros del
# modelo (análogo a SPEC-035/038 pero más ligero para voz en vivo). Dispositivo:
# cuda (recomendado en GPU compartida con prioridad), cpu (fallback si GPU ocupada
# por batch, degradación documentada). Cuantización: int8 (GPU compartida) o
# float16 (GPU dedicada, no disponible en piloto, ADR-011 P3).
STT_LIVE_LANGUAGE=es
STT_LIVE_DEVICE=cuda
STT_LIVE_COMPUTE_TYPE=int8
#
# TTS en vivo (SPEC-048): interfaz conmutable Piper generativo ↔ modo bajo-cómputo
# pregrabado (audios concatenables, coste GPU ~0, ADR-012 §3). Conmutable sin
# rediseño: `docker-compose up` con TTS_MODE=prerecorded sirve respuestas
# pregrabadas; con TTS_MODE=piper usa síntesis en vivo (presupuesto de GPU).
# Por defecto: piper (generativo, más flexible); cambiar a prerecorded si
# latencia degradada bajo GPU compartida.
TTS_MODE=piper
#
# PIPER_VOICE: voz Piper para síntesis — VARIABLE COMPARTIDA entre el
# `voice_tts` INERTE de este bloque (VoiceBot en vivo archivado, nunca
# implementado) y el `tts_worker` REAL del Entregable #6 (bloque nuevo más
# abajo, "TTS asíncrono de respuesta"): docker-compose.yml pasa el MISMO
# valor de esta única variable de entorno a ambos servicios (cada uno con su
# propio default de fábrica SI la variable no está seteada aquí; si SÍ está
# seteada, como en este archivo, ambos reciben el valor de abajo). El
# catálogo real de Piper NO incluye ninguna voz "es_CO-*" auténtica
# (`es_CO-pablo-medium` es un 404, hallazgo de SPEC-067) — se fija aquí el
# valor CORREGIDO y validado por evidencia real (SPEC-067/ADR-014,
# `es_ES-davefx-medium`), documentado en detalle en el bloque "TTS asíncrono
# de respuesta" más abajo. El `voice_tts` inerte no ejecuta ninguna síntesis
# real hoy (placeholder), así que heredar este valor no tiene efecto
# observable para él.
PIPER_VOICE=es_ES-davefx-medium
#
# TTS_VRAM_FRACTION: fracción de VRAM exclusivamente reservada para TTS en vivo
# (0.0-1.0, ADR-011 §2, ADR-012 §3). Evita contención bajo GPU compartida.
# p.ej. 0.3 = 30% de VRAM para TTS, resto para batch STT large-v3 (pausado
# por señal Redis mientras hay ≥1 llamada en vivo activa, SPEC-044/SPEC-050).
TTS_VRAM_FRACTION=0.3
#
# NLU de intent (SPEC-045): confianza mínima para clasificación contra catálogo
# cerrado (0.0-1.0). Respuestas con confianza < umbral se escalan a humano en
# vez de responder con bajo confidence.
INTENT_CONFIDENCE_THRESHOLD=0.7
#
# Concurrencia máxima de llamadas en vivo (C, ADR-011 §4): límite conservador
# del piloto (1-3 típico, fijado empíricamente por THOR en F6 bajo GPU
# compartida). Al llegar C+1, la nueva recibe IVR mínimo + escalación (nunca
# se degrada una activa). Ampliable solo con GPU adicional (decisión futura).
MAX_CONCURRENT_CALLS=1
#
# PBX de media en vivo (SPEC-046, ADR-011 §7): host/puerto del PBX que
# transporta media/SIP en vivo. Por defecto (vacío): PBX on-prem en red local,
# SIN EGRESS NUEVO (P-M, topología preferida). Firewall host DROP + red
# ia_internal con internal:true garantizan cero egress desde voice_stt/voice_tts/NLU.
# Si el Lead confirma PBX EXTERNO (cloud proveedor), habilitar host/puerto
# aquí → requiere firewall host + allowlist en check-externos-backend.sh
# (cambio sensible, C6).
PBX_MEDIA_HOST=
#
# PBX_MEDIA_PORT: puerto del PBX de media (SIP típico: 5060, 5061 TLS, 6050-6099).
PBX_MEDIA_PORT=5060
#
# PBX_MEDIA_AUTH_TOKEN: credencial del PBX de media (API key, bearer token, etc.)
# CHECKPOINT C3: NUNCA hardcoded en repo, SOLO en env/secret manager en producción.
# En development local, placeholder. OBLIGATORIO si PBX_MEDIA_HOST no está vacío
# (PBX externo). Generar fuerte: openssl rand -hex 32
PBX_MEDIA_AUTH_TOKEN=

# ============================================================================
# TTS asíncrono de respuesta — Entregable #6 (SPEC-067/069, ADR-014)
# ============================================================================
# DECISIÓN DE NOMBRES (confirmada por el Lead): el bloque "VoiceBot en vivo"
# de arriba (TTS_MODE/PIPER_VOICE/TTS_VRAM_FRACTION) pertenece al servicio
# `voice_tts` de docker-compose.yml — un PLACEHOLDER INERTE del VoiceBot en
# vivo con barge-in (PLAN-005), NUNCA implementado (memoria de proyecto:
# "No GPU / VoiceBot pivot"). Se DEJA INTACTO a propósito (no se reactiva, no
# se borra) para no perder ese diseño archivado. Este bloque NUEVO configura
# el servicio DISTINTO y SÍ REAL de este Entregable #6: TTS ASÍNCRONO,
# 100% CPU (sin GPU/VRAM), para responder notas de voz de WhatsApp
# (servicio `tts_worker`) — variables con prefijo `RESPUESTA_TTS_*`,
# deliberadamente diferentes de las de arriba para que nadie confunda ambos
# vectores en logs/deploy/runbook.
#
# PIPER_VOICE (REUTILIZADA, ya fijada arriba en el bloque VoiceBot en vivo,
# una sola fuente de verdad — no se reasigna aquí): motor+voz decididos por
# evidencia real medida en CPU (SPEC-067, THOR): Piper TTS 1.8.0,
# es_ES-davefx-medium — única combinación que cumple el techo ≤10s en las 8
# categorías de guion probadas (peor caso p95 = 7.19s).
#
# PIPER_VOICE_DIR: directorio de pesos Piper montado por volumen para
# `tts_worker` (`respuesta_tts_piper_voices`, SEPARADO del volumen legado
# `voice_piper_voices` del `voice_tts` inerte). Sin descarga en runtime
# (ADR-009/012): descarga manual pre-deployment.
PIPER_VOICE_DIR=/piper_voices
#
# RESPUESTA_TTS_ENGINE: motor de síntesis (SPEC-067/ADR-014). Único
# validado hoy: "piper". Documentado para el runbook (SPEC-072), no conmuta
# un segundo motor en runtime.
RESPUESTA_TTS_ENGINE=piper
#
# RESPUESTA_TTS_MAX_CHARS: límite de longitud sintetizable. THOR (SPEC-071)
# midió el motor real bajo carga CPU concurrente: guiones de 600-750 chars
# superaban el techo de 10s (11-15s medidos); 420 SÍ cumple el techo incluso
# bajo carga. Un guion más largo NO se sintetiza — cae a tts_estado="error"
# (fallback a texto).
RESPUESTA_TTS_MAX_CHARS=420
#
# RESPUESTA_TTS_TIMEOUT_SECONDS: techo de latencia (Q4-b, ADR-014, ≤5-10s)
# de síntesis+transcodificación por job; si se excede, tts_estado="error"
# sin enviar audio a medias.
RESPUESTA_TTS_TIMEOUT_SECONDS=10
#
# RESPUESTA_TTS_CONCURRENCIA: throttling de la cola tts:jobs (Adenda
# SPEC-067, R-84) — 1 job de síntesis a la vez por defecto (no medido con
# workers reales en el sandbox del spike; SPEC-071 re-valida en Docker real
# sobre la máquina de 4 vCPU compartida con STT/RAG/sentimiento).
RESPUESTA_TTS_CONCURRENCIA=1
#
# RESPUESTA_TTS_PERSIST_ENABLED: retención por defecto = NO persistir el
# clip TTS de salida tras enviarlo (ADR-012 §5/ADR-014 decisión 5, herencia)
# — basta el guion aprobado ya persistido en rag_drafts/Message. Activar
# "true" SOLO por una política explícita de auditoría (régimen SPEC-041,
# cifrado vía audio_store.py) — CAMBIO SENSIBLE (C6), requiere aprobación
# separada del Lead, nunca el comportamiento por defecto.
RESPUESTA_TTS_PERSIST_ENABLED=false

# ============================================================================
# PBX externo — GRABACIONES (Entregable #4, SPEC-035/SPEC-037, ADR-010 — CONTINGENCIA SOLO SI PBX EXTERNO)
# ============================================================================
# POR DEFECTO: PBX on-prem (Asterisk/FreeSWITCH), sin egress nuevo (SUP-42).
# Si el Lead confirma PBX EXTERNO (proveedor cloud con URL de descarga),
# habilitar las variables abajo. NUNCA activar para PBX on-prem — aumenta riesgo R-45.
#
# SPEC-035/ADR-010: egress ACOTADO solo desde app/services/telefonia/ o
# app/integrations/pbx/ (transporte, no inferencia). STT/IA NUNCA acceden al PBX.
# Allowlist por ruta auditada en CI (check-externos-backend.sh).
#
# PBX_EXTERNAL_ENABLED: boolean. "false" por defecto (PBX on-prem, no egress).
# Poner "true" SOLO si Lead confirma PBX externo con descarga de grabaciones.
PBX_EXTERNAL_ENABLED=false
#
# PBX_EXTERNAL_HOST: host del PBX externo (p.ej. "pbx.provider.com" o IP).
# SOLO usado si PBX_EXTERNAL_ENABLED=true. En firewall host: egress permitido
# SOLO a este host desde app/recording_fetch_worker (red `app`, ADR-010).
# OBLIGATORIO si PBX_EXTERNAL_ENABLED=true, ignorado si false.
PBX_EXTERNAL_HOST=
#
# PBX_EXTERNAL_PORT: puerto del PBX externo (p.ej. 443, 8443). Por defecto: 443.
PBX_EXTERNAL_PORT=443
#
# PBX_EXTERNAL_AUTH_TOKEN: credencial del PBX externo (p.ej. API key, bearer token).
# CRÍTICO (C3): NUNCA hardcoded en repo, SOLO en env/secret manager en producción.
# En development local, usar placeholder. OBLIGATORIO si PBX_EXTERNAL_ENABLED=true.
PBX_EXTERNAL_AUTH_TOKEN=
#
# WEBHOOK_VERIFY_TOKEN: token para validar solicitudes GET del webhook de grabaciones
# (challenge). NUNCA igual al WHATSAPP_VERIFY_TOKEN (dominios distintos). OBLIGATORIO.
# Generar: openssl rand -hex 16
WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token-placeholder
#
# WEBHOOK_SECRET: secreto para validar firma HMAC-SHA256 del webhook POST
# (header X-Webhook-Signature-256 sobre el audio crudo, mismo patrón que
# X-Hub-Signature-256 de WhatsApp). CRÍTICO (C3). Generar fuerte.
WEBHOOK_SECRET=your-webhook-secret-placeholder

# ============================================================================
# SPA (Entregable #1) — integración por feature-flag (SPEC-020)
# ============================================================================
# Estas variables las lee Vite (prefijo VITE_) para la SPA de la RAÍZ del
# repo (src/), NO el backend. Se documentan aquí junto al resto del entorno
# para tener un único `.env.example` de referencia; en desarrollo local de
# la SPA basta con copiar estas líneas a un `.env.local` en la raíz (Vite lo
# carga automáticamente; ver src/lib/env.ts).
#
# VITE_USE_REAL_API: "true" para consumir las APIs reales del backend. Por
# defecto OFF ("false"/ausente): la SPA usa EXCLUSIVAMENTE los fixtures mock
# (src/mocks/*.json), sin ninguna llamada de red (Entregable #1 intacto).
VITE_USE_REAL_API=false
# VITE_API_BASE_URL / VITE_WS_BASE_URL: SOLO localhost o red interna (NUNCA
# un dominio de terceros — proyecto SENSIBLE, .no-externo).
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
# Credenciales de sesión de DESARROLLO (SPEC-020): el Entregable #1 no tiene
# pantalla de login (fuera de alcance), así que con el flag ON la capa de
# datos hace un login transparente con estas credenciales para poder
# ejercitar la Bandeja/RAG reales. Deben existir en la BD de desarrollo del
# backend (seed/usuario de prueba); NUNCA usar una contraseña real aquí ni
# comitear `.env`/`.env.local` con un valor real (ver .gitignore).
VITE_DEV_TENANT_SLUG=demo
VITE_DEV_USER_EMAIL=agente@demo.local
VITE_DEV_USER_PASSWORD=changeme-solo-para-desarrollo-local
