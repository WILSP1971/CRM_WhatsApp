# Caddyfile — Reverse proxy TLS (SPEC-035, SPEC-044, ADR-010, ADR-011)
# TLS de producción parametrizado por dominio/env — SPEC-083 (PLAN-011 F3, ADR-016)
# Expone SOLO:
# 1. Path del webhook de grabaciones (/webhooks/pbx/recordings) — SPEC-035
# 2. Path del voice_gateway (/voice/ws) con soporte WebSocket/WSS — SPEC-044
# Nunca STT/IA ni BD.
#
# TLS (SPEC-083, C3: sin secretos en el repo):
# - `{$CADDY_DOMAIN:localhost}` (desarrollo, por defecto): Caddy sirve HTTP
#   plano sobre `localhost`/vacío — Caddy NO emite certificados ACME para
#   `localhost` (no es un dominio público resoluble), así que el
#   comportamiento de desarrollo queda INTACTO. Para HTTPS local opcional,
#   Caddy seguiría pudiendo auto-generar un certificado autofirmado si se
#   solicita explícitamente, pero no es el comportamiento por defecto aquí.
# - Con un DOMINIO REAL (p. ej. `CADDY_DOMAIN=crm.ejemplo.com` en el `.env`
#   del host de producción — nunca commiteado, ver `.env.example`): Caddy
#   detecta automáticamente que `{$CADDY_DOMAIN}` ya NO es `localhost` y
#   gestiona TLS vía ACME/Let's Encrypt de forma AUTOMÁTICA (comportamiento
#   nativo de Caddy 2 cuando el "site address" del bloque es un dominio
#   público): solicita, instala y renueva el certificado sin configuración
#   adicional ni credenciales en este archivo. Persistencia de certificados
#   ya versionada en `docker-compose.yml` (volúmenes `caddy_data`/
#   `caddy_config`). El reto ACME HTTP-01 requiere que el puerto 80 esté
#   accesible desde internet hacia este host (borde ENTRANTE acotado, ADR-016
#   §4 — no es egress de datos de negocio/PHI).
# - Activar TLS de producción real: en el `.env` del host (NUNCA en este
#   archivo ni en el repo) fijar `CADDY_DOMAIN=<dominio real>` y asegurar que
#   el firewall de host (`scripts/ops/firewall-host.sh`, SPEC-083) permite
#   80/443 entrantes — aplicar ese firewall en un entorno real es un cambio
#   SENSIBLE (C6) que requiere aprobación del Lead + notificación.

# Dominio de listening (desarrollo: localhost, producción: reemplazar por
# dominio real vía la variable de entorno CADDY_DOMAIN — ver .env.example,
# NUNCA un valor hardcodeado aquí).
{$CADDY_DOMAIN:localhost} {
  # TLS: Caddy decide automáticamente según el dominio de arriba.
  # - `localhost`/vacío: HTTP plano de desarrollo (Caddy no emite ACME para
  #   hosts no públicos); comportamiento intacto respecto a antes de SPEC-083.
  # - Dominio público real: Caddy gestiona TLS automático vía ACME/Let's
  #   Encrypt (ningún bloque `tls` explícito necesario; evita hardcodear
  #   rutas de certificado/clave que serían secretos en el repo, C3).
  # Si en el futuro se requiere un certificado propio (CA corporativa en vez
  # de Let's Encrypt), usar `tls /path/to/cert /path/to/key` — rutas de
  # archivo montadas por volumen, NUNCA contenido de certificado/clave
  # literal en este Caddyfile.

  # Proxy a PATHS PERMITIDOS:
  # 1. /webhooks/pbx/recordings (webhook de grabaciones, SPEC-035)
  # 2. /voice/ws (WebSocket/WSS para voice_gateway, SPEC-044)
  # PROHIBIDO:
  # - /api/* (IA, BD, usuario)
  # - /metrics (observabilidad sensible)
  # - /healthz (acceso administrativo)
  # - /swagger (documentación)

  # Webhook de grabaciones: proxy sin reescribir el path (SPEC-035)
  @pbx_webhook {
    path /webhooks/pbx/recordings*
  }
  handle @pbx_webhook {
    reverse_proxy api:8000 {
      # Propagar headers originales para validación de firma (HMAC-SHA256)
      header_up X-Original-Host {http.request.host}
      header_up X-Original-Proto {http.request.proto}
    }
  }

  # Voice Gateway WebSocket/WSS: proxy con soporte WebSocket (SPEC-044, ADR-011)
  # Path: /voice/ws — conexión en vivo (media de voz, SIP/RTP abstraído)
  # Caddy soporta proxy de WebSocket de forma nativa; solo necesita detectar
  # el upgrade HTTP → WS/WSS automáticamente.
  @voice_ws {
    path /voice/ws*
  }
  handle @voice_ws {
    reverse_proxy voice_gateway:8888 {
      # Propagar headers de upgrade y conexión para WebSocket
      header_up Connection "Upgrade"
      header_up Upgrade "websocket"
      header_up X-Original-Host {http.request.host}
      header_up X-Original-Proto {http.request.proto}
    }
  }

  # Rechazar cualquier otro path
  handle {
    respond 403 "Forbidden: only /webhooks/pbx/recordings and /voice/ws are exposed"
  }

  # Logging básico (sensible: no loguear POST body que contiene audio)
  log {
    output stdout
    format json
    level warn
  }
}
